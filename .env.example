# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Project Settings > API). El sitio funciona sin estas variables, solo que
# el catálogo usa siempre los precios de data/perfumes.json / data/combos.json
# y /admin no deja loguearse.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta Pixel (Administrador de eventos de Meta > Origen de datos > ID del pixel,
# 15 o 16 dígitos). Sin este valor el pixel no se carga y el sitio funciona igual.
# Es NEXT_PUBLIC_, así que se incorpora al hacer el build: después de cambiarlo
# hay que volver a correr `npm run deploy`.
NEXT_PUBLIC_META_PIXEL_ID=
