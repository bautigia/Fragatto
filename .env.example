# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Project Settings > API). El sitio funciona sin estas variables, solo que
# el catálogo usa siempre los precios de data/perfumes.json / data/combos.json
# y /admin no deja loguearse.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
